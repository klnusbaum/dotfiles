#!/usr/bin/env bash
# Attach to the work tmux session on the devbox. Port forwards named in
# REMOTE_WORK_SERVER_PORT_FORWARDS (ssh -L syntax; several, space-separated)
# ride this connection and end with it, so detaching leaves nothing behind.

if [[ -z "$REMOTE_WORK_SERVER" ]]; then
    echo "REMOTE_WORK_SERVER environment variable not set" >&2
    exit 1
fi

forwards=()
for forward in $REMOTE_WORK_SERVER_PORT_FORWARDS; do
    forwards+=(-L "$forward")
done

ssh "${forwards[@]}" "$REMOTE_WORK_SERVER" -t tmux new-session -A -s work
